<Project Sdk="Microsoft.NET.Sdk">

  <!-- The checks of the primitives, the same values as cpp/tests, without a test framework. They run on
       .NET; net481 is checked by building PixieLib for it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixieLib\PixieLib.csproj" />
  </ItemGroup>

</Project>
